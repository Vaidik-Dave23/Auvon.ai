# ==========================================
# Azure Deployment Environment Variables
# Configure these in Azure Portal:
# - App Service: Configuration -> Application settings
# - Container Apps: Container -> Environment variables
# ==========================================

# 1. Database
# PostgreSQL URL (e.g., from Neon, Supabase, Azure PostgreSQL)
# Example: postgresql://username:password@ep-cool-forest-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# MongoDB URI (Atlas / Cosmos DB MongoDB API)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=auvon

# 2. Security & Auth
SECRET_KEY=la-la-land-2016
ALGORITHM=HS256

# 3. AI Providers
AIPIPE_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
OPENAI_API_KEY=

# 4. Optional Integrations
RESEND_API_KEY=
YOUTUBE_API_KEY=

# 5. Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. Runtime & Server
PORT=8080
WEBSITES_PORT=8080
ENVIRONMENT=production

# 7. Additional CORS Origins (comma-separated, optional)
# CORS_ORIGINS=https://my-custom-domain.com
